# Скопируй в .env и заполни. .env не коммитится (см. .gitignore).

# --- LLM (общий для обоих ботов) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- team_bot ---
TEAM_BOT_TOKEN=
TEAM_CHAT_ID=
# Apple ID + app-specific password (НЕ основной пароль!) — сгенерировать
# на appleid.apple.com → Sign-In and Security → App-Specific Passwords.
ICLOUD_APPLE_ID=
ICLOUD_APP_SPECIFIC_PASSWORD=
ICLOUD_REMINDERS_LIST_NAME=Кубышка — задачи

# --- channel_bot ---
CHANNEL_BOT_TOKEN=
CHANNEL_ID=
# Опционально: чат обсуждения при канале — если не задан, бот только постит.
DISCUSSION_CHAT_ID=
POST_INTERVAL_HOURS=24

# --- общее ---
# Путь к локальному чекауту FinAssist — для контекста ассистента и
# генерации постов по AI_CHANGELOG.md/BACKLOG.md.
FINASSIST_DOCS_PATH=/Users/arakcheevpm/Documents/FinAssist/Docs
