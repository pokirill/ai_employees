# Скопируй в .env и заполни. .env не коммитится (см. .gitignore).

# --- LLM (общий для обоих ботов, напрямую через OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Не оставляй пустым (даже пустая строка тут ломает openai SDK — см.
# shared/config.py) — меняй, только если реально нужен прокси/шлюз перед OpenAI.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- team_bot ---
TEAM_BOT_TOKEN=
TEAM_CHAT_ID=
# R-COST: опционально — отдельная (например, более дешёвая/быстрая) модель
# для команд-бота, независимо от OPENAI_MODEL, который использует
# channel_bot. Пусто → берётся OPENAI_MODEL.
TEAM_BOT_MODEL=
# R-COST: не более N вопросов ассистенту в час НА ЧАТ — страховка от
# случайного/нарочного вычерпывания бюджета. 0 = лимит выключен.
TEAM_BOT_MAX_QUESTIONS_PER_HOUR=30
# Час (по местному времени машины) ежедневного дайджеста открытых задач в
# TEAM_CHAT_ID — см. README "Ежедневные напоминания". Не шлётся, если
# TEAM_CHAT_ID не задан; можно проверить в любой момент через /remindnow.
TEAM_REMINDER_HOUR=10
# Час В СУББОТУ (по местному времени машины) итогов недельного спринта —
# что сделали/отменили/перенесли, БЕЗ единого вызова LLM (см.
# shared/sprint_digest.py). Проверить в любой момент через /sprintnow.
TEAM_SPRINT_HOUR=19
# Apple ID + app-specific password (НЕ основной пароль!) — сгенерировать
# на appleid.apple.com → Sign-In and Security → App-Specific Passwords.
ICLOUD_APPLE_ID=
ICLOUD_APP_SPECIFIC_PASSWORD=
# Точное название уже существующего расшаренного списка в Напоминаниях —
# должно совпадать 1-в-1 с тем, что видно в приложении на телефоне.
ICLOUD_REMINDERS_LIST_NAME=Кубышка — задачи

# --- мини-апп "доска задач" (webapp/server.py) ---
# Путь к sqlite-файлу — общий для team_bot (пишет/читает задачи) и webapp
# (отдаёт их через API). Раздельные процессы должны указывать на один файл.
TASKS_DB_PATH=kubyshka_tasks.db
# Публичный https-адрес, где задеплоен webapp/server.py — обязателен для
# кнопки /board (Telegram не открывает web_app на http/localhost). Пусто →
# /board сообщает, что мини-апп ещё не задеплоен.
WEBAPP_URL=
# Порт локального запуска webapp/server.py (за прокси/туннелем наружу светится WEBAPP_URL).
WEBAPP_PORT=8080

# --- channel_bot ---
CHANNEL_BOT_TOKEN=
CHANNEL_ID=
# Опционально: чат обсуждения при канале — если не задан, бот только постит.
DISCUSSION_CHAT_ID=
# Расписание постов (3/день, с закреплённой темой на слот) зашито в
# channel_bot/main.py (_DAILY_SLOTS) — не через .env, см. код.
# R-COST: лимит ответов в обсуждении НА ПОЛЬЗОВАТЕЛЯ (публичный чат — общий
# на всех лимит душил бы всех из-за одного активного человека). 0 = выключено.
CHANNEL_DISCUSSION_MAX_REPLIES_PER_HOUR=10
# Чат, откуда доступны админ-команды (/postnow, /queue, /status, /pause и
# т.д.) — обычно тот же чат, что TEAM_CHAT_ID у team_bot. Без него команды
# доступны из любого чата (ок для локальной разработки, не для продакшена).
CHANNEL_ADMIN_CHAT_ID=
# 1 → перед публикацией пост уходит в CHANNEL_ADMIN_CHAT_ID на ревью
# (кнопки "Опубликовать"/"Пропустить") вместо немедленной автопубликации.
# Требует CHANNEL_ADMIN_CHAT_ID — без него игнорируется (некуда слать
# черновик). По умолчанию 0 — канал постит полностью автономно.
CHANNEL_REQUIRE_APPROVAL=0
# Ссылка на бета-тест приложения — иногда (не на каждый пост, ~1 из 5)
# добавляется в конец поста как приглашение. Пусто → приглашения не будет
# (не выдумываем несуществующую ссылку — беты пока нет).
BETA_INVITE_URL=

# --- общее ---
# Путь к локальному чекауту FinAssist — для контекста ассистента и
# генерации постов по AI_CHANGELOG.md/BACKLOG.md.
FINASSIST_DOCS_PATH=/Users/arakcheevpm/Documents/FinAssist/Docs
# Опционально: второй репозиторий (бэкенд) — team_bot-ассистент увидит доки
# и оттуда тоже. Пусто → ассистент отвечает только по контексту FinAssist.
FINIK_BACKEND_DOCS_PATH=/Users/arakcheevpm/Desktop/Кубышка/Finik-backend/docs
